{
  "name": "grc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:container": "node scripts/build-in-container.mjs",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "check:validators": "node scripts/check-validator-fires.mjs",
    "check:roster": "node scripts/check-roster.mjs",
    "snapshot": "node scripts/snapshot-derivations.mjs",
    "prisma-report": "node scripts/prisma-report.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:validators && npm run check:roster",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "scan:vulns": "node scripts/scan-vulns.mjs",
    "scan:code": "node scripts/scan-code.mjs",
    "sbom": "node scripts/sbom.mjs",
